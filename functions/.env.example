# Cloudflare R2 configuration for Cloud Functions.
# Copy this file to .env (deployed) or .env.local (local only, higher priority).
# NEVER commit the real .env / .env.local files.

# Cloudflare dashboard -> R2 -> Overview (right panel): Account ID
R2_ACCOUNT_ID=

# R2 -> Manage R2 API Tokens -> Create Account API token
# Permission: Object Read & Write, applied to your bucket only.
# The pair below is the S3-compatible credential (NOT a Cloudflare API token).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name (lowercase letters, numbers and hyphens, 3-63 chars)
R2_BUCKET=aigens-app-builds

# Shared secret required by write endpoints (upload-url / commit-build / delete-builds).
# Generate one, e.g.: openssl rand -hex 32
R2_API_TOKEN=

# Optional: custom domain bound to the bucket, e.g. https://dl.yourdomain.com
# When set, download & plist URLs use permanent public links instead of presigned ones.
# R2_PUBLIC_BASE_URL=
